{
  "name": "obsidian-link-flair",
  "version": "0.1.2",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "Inline favicons and readable labels for web, app, and native Obsidian links.",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src manifest.json LICENSE",
    "build": "npm run typecheck && node esbuild.config.mjs",
    "test": "vitest run",
    "check": "npm run lint && npm test && npm run build",
    "package": "npm run check && node scripts/package.mjs",
    "test:install": "npm run build && node scripts/install-test-vault.mjs",
    "test:obsidian": "electron scripts/obsidian-harness.cjs",
    "test:smoke": "node scripts/smoke-obsidian.mjs",
    "test:appearance": "node scripts/smoke-appearance.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "test:apps": "node scripts/smoke-supported-apps.mjs"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@electron/remote": "2.1.3",
    "@eslint/js": "9.39.5",
    "@eslint/json": "0.14.0",
    "@lezer/common": "1.5.2",
    "@types/node": "26.5.0",
    "electron": "44.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "globals": "17.12.0",
    "jsdom": "29.1.1",
    "obsidian": "1.13.1",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  },
  "overrides": {
    "eslint-plugin-obsidianmd": {
      "obsidian": "$obsidian"
    }
  }
}
